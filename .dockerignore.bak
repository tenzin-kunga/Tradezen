# ── TradeZen Root .dockerignore ──────────────────────────────────────
# This file controls what goes into Docker build context (context: .)

# ── Dependencies ────────────────────────────────────────────────────────
node_modules
**/node_modules
npm-debug.log
yarn-debug.log*
yarn-error.log*

# ── Build Outputs ──────────────────────────────────────────────────────
dist
build
.next
out
**/.next
**/dist
**/build
**/out

# ── Environment & Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.docker.example
secrets/
credentials/

# ── Tests ────────────────────────────────────────────────────────────────
test
**/test
**/*.spec.ts
**/*.test.ts
coverage
**/coverage
.jest-cache

# ── IDEs & Editor ──────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
**/.vscode
**/.idea

# ── OS Files ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Git ───────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.gitmodules
**/.git

# ── CI/CD ──────────────────────────────────────────────────────────────
.github
**/.github
.gitlab-ci.yml
.travis.yml

# ── Logs ────────────────────────────────────────────────────────────────
logs
*.log
**/*.log

# ── Documentation (optional - keep for build context) ───────────────────
# *.md
# !README.md
# !SECURITY.md
# !DEPLOYMENT.md

# ── Misc ────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
**/tmp
**/temp

# ── Keep These (Required for Build) ──────────────────────────────────
# packages/         ← INCLUDED (required for monorepo build)
# apps/            ← INCLUDED (source code)
# package.json     ← INCLUDED (root workspace)
# turbo.json       ← INCLUDED (monorepo config)
# tsconfig.json    ← INCLUDED (root TypeScript config)
