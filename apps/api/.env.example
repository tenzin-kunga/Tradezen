# Production: set this to your Neon / Railway / Supabase connection string
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local dev fallbacks (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=tradezen
DB_PASSWORD=pass
DB_PORT=5432

# Port the API listens on
PORT=3001

# Allowed CORS origin (set to your Vercel URL in production)
WEB_URL=http://localhost:3000
