# Production: set this to your Neon / Railway / Supabase connection string
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local dev fallbacks (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=tradezen
DB_PASSWORD=pass
DB_PORT=5432

# Port the API listens on
PORT=3001

# Allowed CORS origin (set to your Vercel URL in production)
WEB_URL=http://localhost:3000

# OpenRouter chat configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_AVAILABLE_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,google/gemma-3-4b-it:free,nvidia/nemotron-nano-9b-v2:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=TradeZen
