# Provider
AI_PROVIDER=ollama
DEFAULT_MODEL=qwen3:latest

# Ollama
OLLAMA_HOST=http://localhost:11434

# OpenRouter (production)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database (for RAG features — optional, graceful degradation if not set)
DATABASE_URL=

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Rate limits
CHAT_RATE_LIMIT=60/min
RESEARCH_RATE_LIMIT=5/min
COACHING_RATE_LIMIT=20/hour
EMBEDDING_RATE_LIMIT=100/min

# Concurrency
MAX_CONCURRENT_OLLAMA=4
MAX_CONCURRENT_OPENROUTER=20

# Validation
MAX_PROMPT_SIZE=20000
MAX_MESSAGES=50
MAX_RETRIEVAL_TOP_K=10
MAX_TOOL_CALLS=5
MAX_LANGGRAPH_STEPS=20

# Timeouts (seconds)
OLLAMA_TIMEOUT=60
OPENROUTER_TIMEOUT=30
SQL_TIMEOUT=5
RETRIEVAL_TIMEOUT=3

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30

# Retry
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5

# Budget
DAILY_COST_BUDGET=20.0

# Auth (NestJS forwards JWT)
AUTH_SECRET=

# Feature flags
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_TOOLS=true
ENABLE_STREAMING=true
ENABLE_CACHE=true

# NestJS
NESTJS_INTERNAL_API_KEY=
