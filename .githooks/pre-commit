#!/usr/bin/env bash
# ── Pre-commit Hook: Prevent Secrets Commit ───────────────────────────────────
# Place at: .git/hooks/pre-commit (make executable with chmod +x)

set -e

echo "🔍 Scanning for secrets in staged files..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Patterns to detect (extend as needed)
SECRET_PATTERNS=(
  "sk-or-v1-[A-Za-z0-9]{32,}"          # OpenRouter API keys
  "API_KEY=[\"']?[A-Za-z0-9]{20,}"     #Generic API keys
  "JWT_SECRET=[\"']?[A-Za-z0-9]{32,}"  # JWT secrets
  "DB_PASSWORD=[\"']?[A-Za-z0-9]{16,}" # DB passwords
  "-----BEGIN [A-Z ]+ PRIVATE KEY-----" # Private keys
)

VIOLATIONS=0

for file in $STAGED_FILES; do
  # Skip binary files, vendor, node_modules
  if [[ "$file" == *"node_modules"* ]] || [[ "$file" == *"dist/"* ]] || [[ "$file" == *".min.js"* ]]; then
    continue
  fi

  # Only check text files
  if file "$file" | grep -q "text"; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if grep -nE "$pattern" "$file" > /dev/null 2>&1; then
        echo "⛔ Potential secret found in $file:"
        grep -nE "$pattern" "$file" | head -3
        VIOLATIONS=$((VIOLATIONS + 1))
      fi
    done
  fi
done

if [ $VIOLATIONS -gt 0 ]; then
  echo ""
  echo "❌ Commit blocked: Secrets detected in staged files."
  echo "   Remove or mask these secrets before committing."
  echo ""
  echo "   To exclude a file, use:"
  echo "   git reset HEAD <file> && git checkout -- <file>"
  echo ""
  exit 1
fi

echo "✅ No secrets detected. Commit allowed."
exit 0
