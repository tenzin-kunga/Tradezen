# ── TradeZen Environment Variables ──────────────────────────────────

# API (NestJS)
PORT=3001
WEB_URL=http://localhost:3000

# Database (individual params — used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradezen

# Database (connection string — takes priority over individual params)
# DATABASE_URL=postgresql://postgres:pass@localhost:5432/tradezen

# JWT Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
