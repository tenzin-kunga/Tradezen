# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ── Local Environment Files ──────────────────────────────────────────────────
# Use .env.example as template; real .env files NEVER committed
.env
.env.*
!.env.example
!.env.docker.example

# Docker env (gitignored in production)
.env.docker
.env.docker.local

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Build Outputs ────────────────────────────────────────────────────────────
.next/
out/
build
dist
.cache/
.temp/
*.tsbuildinfo

# TypeScript emit artifacts (NestJS builds to dist/; never commit src-side .js)
apps/api/src/**/*.js
apps/api/src/**/*.js.map

# ── Testing ──────────────────────────────────────────────────────────────────
coverage
.jest-cache/
.vitest/
.pytest/

# ── Turborepo ────────────────────────────────────────────────────────────────
.turbo

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── Debug ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
ssl/
certs/
secrets/

# ── API Testing ──────────────────────────────────────────────────────────────
.postman/
postman/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.gitmodules

# ── CI/CD ─────────────────────────────────────────────────────────────────────
# Note: .github/ is intentionally NOT ignored — workflows MUST be committed
.gitlab-ci.yml
.travis.yml
.circleci/

# ── Docker ─────────────────────────────────────────────────────────────────────
Dockerfile
docker-compose*.yml
.dockerignore
!apps/api/Dockerfile
!apps/web/Dockerfile
!apps/ai-service/Dockerfile
!docker-compose.yml
!.dockerignore

# ── Documentation (keep README.md, add others as needed) ──────────────────────
# *.md
!README.md
!PROJECT_RUNDOWN.md
!SECURITY.md
!DEPLOYMENT.md

# ── Package Manager Locks (keep, but often committed) ─────────────────────────
# package-lock.json (keep)
# yarn.lock (keep)
# pnpm-lock.yaml (keep)
bun.lock (keep)

# ── Temporary Files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Backups ───────────────────────────────────────────────────────────────────
backups/


# Uploads
apps/api/uploads/

# Dev runtime logs (stdout/stderr captures from start.bat / WMI-spawned dev servers)
*.err

# GSD planning workflow artifacts (local only)
.planning/

# OpenCode configuration and plans (local agent artifacts)
.opencode/

nul

# brainstorm companion cache.superpowers/
