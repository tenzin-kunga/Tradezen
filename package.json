{
  "name": "tradezen",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run build --filter=@tradezen/db && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/express-serve-static-core": "^5.1.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qs": "^6.15.1",
    "api": "workspace:*",
    "prettier": "^3.7.4",
    "styled-jsx": "^5.1.6",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
