# ── TradeZen Docker Environment ─────────────────────────────────────────────
# Copy this file to `.env.docker` and fill in real values.
# NEVER commit .env.docker with actual secrets!

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_USE_STRONG_RANDOM_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tradezen

# Alternative: full connection string (takes precedence over individual params)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ── JWT Secrets (generate with: openssl rand -base64 64) ────────────────────
# ── node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" ────────
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_STRONG_RANDOM_SECRET

# ── Frontend / CORS ─────────────────────────────────────────────────────────
# In production, set to your actual frontend domain
WEB_URL=http://localhost:3000

# ── OpenRouter AI Chat (legacy — now routed through ai-service) ──────────────
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_AVAILABLE_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,google/gemma-3-4b-it:free,nvidia/nemotron-nano-9b-v2:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=TradeZen

# ── AI Service (FastAPI) ────────────────────────────────────────────────────
AI_PROVIDER=ollama
DEFAULT_MODEL=qwen3:latest
OLLAMA_HOST=http://ollama:11434
NESTJS_INTERNAL_API_KEY=tradezen-internal
MAX_CONCURRENT_OLLAMA=4
DAILY_COST_BUDGET=20.0

# ── Cloudinary (Image Storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=tradezen
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=200
FULL_WIDTH=1200
FULL_HEIGHT=800
MAX_IMAGES_PER_TRADE=10
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ── Notes ────────────────────────────────────────────────────────────────────
# 1. Generate strong JWT secrets:
#    $ openssl rand -base64 64
#
# 2. Generate strong DB password (at least 32 chars, mixed case, numbers, symbols)
#
# 3. In production:
#    - Use Docker secrets (Swarm/K8s) or cloud provider secret manager
#    - Set NODE_ENV=production (already in infra/docker-compose.yml)
#    - Set DATABASE_URL to Neon/Railway connection string with SSL
#    - Set WEB_URL to https://tradezen.yourdomain.com
#
# 4. To use with Docker Compose:
#    $ cp .env.docker .env.docker.local  # (ensure .env.docker is gitignored)
#    $ docker compose --file infra/docker-compose.yml --env-file .env.docker up -d
#
# 5. Required env vars (must be set):
#    ✓ DB_PASSWORD
#    ✓ JWT_SECRET
#    ✓ JWT_REFRESH_SECRET
#    ✓ OPENROUTER_API_KEY (if chat feature used)

# ── Finnhub ────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=CHANGE_ME_GET_YOUR_KEY_FROM_FINNHUB_DASHBOARD
